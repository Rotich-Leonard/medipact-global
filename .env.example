# Copy this file to .env for local development. Never commit .env.
PORT=3000
NODE_ENV=development

# MongoDB Atlas connection string (use a dedicated database user with least privilege)
MONGODB_URI=

# Generate a unique secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Initial administrator (npm run seed creates this account if none exists)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Contact-form email (optional until SMTP is configured)
MAIL_TO=cardiothoracicsurgeonseries@gmail.com
MAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Public production URL with no trailing slash, e.g. https://your-domain.example
APP_URL=http://localhost:3000

# Maximum uploaded video clip size in MB
MAX_VIDEO_MB=150

# Optional encryption key for SMTP credentials stored in admin settings
# SETTINGS_KEY=
